# =============================================================================
# COMMON SETTINGS (required on both externo and interno)
# =============================================================================

NEXT_BASE_PATH=/jurisprudencia

SERVER_HOST=0.0.0.0
SERVER_PORT=80

PUBLIC_STATES="público"

# Elasticsearch JVM heap size — set to ~50% of available RAM
ES_JAVA_OPTS="-Xms4g -Xmx4g"

# Sync shared secret — must be the same value on both deployments
SYNC_SECRET=<strong-random-secret>

# Microsoft 365 shared mailbox for sync emails
# Requires an Azure app with Mail.Send + Mail.ReadWrite application permissions,
# scoped to this mailbox via an Exchange application access policy.
SYNC_MS_TENANT_ID=<azure-tenant-id>
SYNC_MS_CLIENT_ID=<azure-client-id>
SYNC_MS_CLIENT_SECRET=<azure-client-secret>
SYNC_MS_MAILBOX=sync@yourdomain.onmicrosoft.com

# =============================================================================
# EXTERNO-ONLY SETTINGS
# =============================================================================

RSS_LINK="https://<your-domain>/jurisprudencia"

SYNC_ROLE=externo

# Optional: only process sync emails from this address (defaults to SYNC_MS_MAILBOX)
# SYNC_MS_TRUSTED_FROM=sync@yourdomain.onmicrosoft.com

# =============================================================================
# INTERNO-ONLY SETTINGS
# =============================================================================

ANONIMIZADOR_URL=https://<your-domain>/dev-jurisprudencia-anonimizador/
ANONIMIZADOR_SECRET=<anonimizador-secret>

SYNC_ROLE=interno

# Optional: recipient address for sync emails (defaults to SYNC_MS_MAILBOX)
# SYNC_MS_RECIPIENT=sync@yourdomain.onmicrosoft.com

# SharePoint ETL — credentials for pulling documents from SharePoint into clitools
TENANT_ID=<azure-tenant-id>
CLIENT_ID=<azure-client-id>
CLIENT_SECRET=<azure-client-secret>
SITE_ID=<sharepoint-site-id>
DRIVES='["Anonimização"]'
