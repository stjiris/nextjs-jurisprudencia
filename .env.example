NEXT_BASE_PATH=/jurisprudencia
ANONIMIZADOR_URL= http://anonimizador_dev:7999/anon-service

SERVER_HOST=0.0.0.0
SERVER_PORT=3000

PUBLIC_STATES="público,privado,preparação,importação"

ES_JAVA_OPTS="-Xms4g -Xmx4g"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILE_SYSTEM_PATH=../jurisprudencia-privada-etl/data
ANONIMIZADOR_SECRET=secret101

# ── Email sync between internal and external deployments ──────────────────────
# Set SYNC_ROLE=interno on the internal deployment and SYNC_ROLE=externo on the
# external deployment. Leave unset to disable the feature entirely.
#
# SYNC_ROLE=interno
# SYNC_ROLE=externo

# Shared HMAC secret — must be identical on both deployments
# SYNC_SECRET=change-me-to-a-long-random-string

# SMTP settings (required on the interno deployment for sending)
# SYNC_SMTP_HOST=mail.example.com
# SYNC_SMTP_PORT=587
# SYNC_SMTP_SECURE=false
# SYNC_SMTP_USER=interno@example.com
# SYNC_SMTP_PASS=smtp-password
# SYNC_SMTP_FROM=interno@example.com
# SYNC_SMTP_TO=externo@example.com

# IMAP settings (required on the externo deployment for receiving)
# SYNC_IMAP_HOST=mailserver
# SYNC_IMAP_PORT=993
# SYNC_IMAP_SECURE=true
# SYNC_IMAP_USER=externo@example.com
# SYNC_IMAP_PASS=imap-password
# SYNC_IMAP_TRUSTED_FROM=interno@example.com