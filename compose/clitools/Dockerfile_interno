FROM node:20.19-bullseye-slim

RUN apt update && \
    apt install -y vim cron git python3 python3-venv python3-dev build-essential ghostscript locales apt-utils && \
    sed -i '/en_US.UTF-8/s/^# //' /etc/locale.gen && locale-gen en_US.UTF-8 && update-locale LANG=en_US.UTF-8 && \
    apt clean && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

RUN python3 -m venv /opt/venv
RUN /opt/venv/bin/pip install --upgrade pip && \
    /opt/venv/bin/pip install camelot-py[cv] pandas cryptography numpy
ENV PATH="/opt/venv/bin:$PATH"
RUN ln -s /opt/venv/bin/python /usr/local/bin/python3

RUN useradd -m clitools
RUN passwd -d clitools
RUN mkdir -p /etc/cron.d/ && touch /etc/cron.d/cron.allow && echo "root\nclitools" > /etc/cron.d/cron.allow

USER clitools
WORKDIR /home/clitools

# util to convert between versions (used by jurisprudencia-privada-etl)
RUN git clone https://github.com/stjiris/version-converter && cd version-converter && npm install && npm run build

# sharepoint ETL — built once at image build time, executed by cron
RUN git clone https://github.com/stjiris/jurisprudencia-privada-etl && cd jurisprudencia-privada-etl && npm install && npm run build
# Every 10 minutes on weekdays
RUN (crontab -l; echo "*/10 9-18 * * 1-5 cd /home/clitools/jurisprudencia-privada-etl && /usr/local/bin/node dist/sharepoint/index.js >> ../jurisprudencia-sharepoint-etl.stdout.log 2>> ../jurisprudencia-sharepoint-etl.stderr.log") | crontab -

# backup
RUN git clone https://github.com/stjiris/backup-jurisprudencia && cd backup-jurisprudencia && npm install
# At 10:00 on Sunday
RUN (crontab -l; echo "0 10 * * 0 cd /home/clitools/backup-jurisprudencia && /usr/local/bin/node cli backup jurisprudencia.13.0,users.0.0,keys-info.0.0 >> ../backup-jurisprudencia.full.stdout.log 2>> ../backup-jurisprudencia.full.stderr.log") | crontab -

# RSS feed
RUN git clone https://github.com/stjiris/jurisprudencia-rss.git && cd jurisprudencia-rss && npm install && npm run build
# At minute 45 past every 3rd hour from 9 through 18 on weekdays
RUN (crontab -l; echo "45 9-18/3 * * 1-5 cd /home/clitools/jurisprudencia-rss && /usr/local/bin/node dist >> ../jurisprudencia-rss.stdout.log 2>> ../jurisprudencia-rss.stderr.log") | crontab -

COPY entrypoint.sh .

USER root

ENTRYPOINT ["./entrypoint.sh"]
