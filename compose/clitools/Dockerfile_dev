FROM node:20.19-bullseye-slim

RUN apt update && \
    apt install -y vim cron git python3 python3-venv python3-dev build-essential ghostscript locales apt-utils && \
    sed -i '/en_US.UTF-8/s/^# //' /etc/locale.gen && locale-gen en_US.UTF-8 && update-locale LANG=en_US.UTF-8 && \
    apt clean && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

RUN python3 -m venv /opt/venv
RUN /opt/venv/bin/pip install --upgrade pip && \
    /opt/venv/bin/pip install camelot-py[cv] pandas cryptography numpy
ENV PATH="/opt/venv/bin:$PATH"
RUN ln -s /opt/venv/bin/python /usr/local/bin/python3

RUN useradd -m clitools
RUN passwd -d clitools
RUN mkdir -p /etc/cron.d/ && touch /etc/cron.d/cron.allow && echo "root\nclitools" > /etc/cron.d/cron.allow

USER clitools
WORKDIR /home/clitools

# All repos are mounted as volumes from the host — no cloning needed.
# Assumes the host has already run `npm install && npm run build` in jurisprudencia-privada-etl.

# sharepoint ETL — every 10 minutes
RUN (crontab -l; echo "*/10 * * * * cd /home/clitools/jurisprudencia-privada-etl && /usr/local/bin/node dist/sharepoint/index.js >> ../jurisprudencia-sharepoint-etl.stdout.log 2>> ../jurisprudencia-sharepoint-etl.stderr.log") | crontab -

COPY entrypoint.sh .

USER root

ENTRYPOINT ["./entrypoint.sh"]